PORT=5000
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hcm_lite?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/hcm_lite
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Optional AI key (server only). Without it the chat shows a "not configured" message.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional office geofence (camera/location attendance)
OFFICE_LAT=24.8607
OFFICE_LNG=67.0011
GEOFENCE_RADIUS_M=150

# Optional: auto-create the first Admin on an empty database
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=

# Auto-create test logins (admin@hcm.local, hr@hcm.local, employee@hcm.local) on start.
# Set to false for the judging deployment so first-run setup appears on a fresh database.
AUTO_SEED_LOGINS=true
